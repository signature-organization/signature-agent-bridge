{
  "name": "@signature-organization/agent-bridge",
  "version": "0.1.0",
  "description": "Durable local job bridge for Claude Desktop and Claude Code",
  "type": "module",
  "license": "Apache-2.0",
  "author": "@ancongui",
  "repository": {
    "type": "git",
    "url": "https://github.com/signature-organization/signature-agent-bridge.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "signature-agent-bridge": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "integrations",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify": "tsx scripts/verify.ts",
    "package": "tsx scripts/package.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:browser && npm run build && npm run verify && npm run package && npm run test:package",
    "test:browser": "playwright test",
    "test:live": "tsx scripts/live-smoke.ts",
    "test:package": "tsx scripts/package-smoke.ts",
    "render:diagrams": "tsx scripts/render-diagrams.ts",
    "generate:api": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "fastify": "5.12.5",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/proper-lockfile": "4.1.4",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
